{
  "name": "payops-commerce",
  "version": "2.1.0",
  "private": true,
  "description": "PayOps - e-commerce storefront with built-in PayOps (payments, orders, refunds, reconciliation) and DevOps tooling.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "prisma:push": "prisma db push",
    "prisma:seed": "node prisma/seed.mjs",
    "db:setup": "node scripts/setup.mjs",
    "worker": "node scripts/worker.mjs",
    "test:integration": "node scripts/integration.mjs",
    "test:webhooks": "node scripts/test-signed-webhooks.mjs"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@prisma/client": "^5.22.0",
    "next": "15.5.29",
    "prom-client": "^15.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^17.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.33",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "postcss": "$postcss"
  }
}
