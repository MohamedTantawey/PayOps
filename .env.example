# Generate locally with setup-local.ps1 (Windows) or setup-local.mjs (Node).
NEXT_PUBLIC_APP_URL=http://localhost:3000
COMMERCE_DB_PASSWORD=GENERATE_LOCALLY
IDENTITY_DB_PASSWORD=GENERATE_LOCALLY
COMMERCE_SERVICE_TOKEN=GENERATE_LOCALLY
IDENTITY_SERVICE_TOKEN=GENERATE_LOCALLY
ADMIN_TOKENS=[]
SESSION_SECRET=GENERATE_LOCALLY
MAINTENANCE_TOKEN=GENERATE_LOCALLY
GRAFANA_ADMIN_PASSWORD=GENERATE_LOCALLY
COOKIE_SECURE=false
GATEWAY_DB_PASSWORD=GENERATE_LOCALLY
GATEWAY_TEST_KEY=sk_test_GENERATE_LOCALLY
GATEWAY_WEBHOOK_SECRET=whsec_test_GENERATE_LOCALLY
# Optional. Commerce uses the gateway when configured; Stripe keys are only a fallback if the gateway is removed.
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
