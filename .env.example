# ==============================================================================
# PayOps Architecture — Environment Configuration
# ==============================================================================

# Server Ports
PORT=3000
WORKER_PORT=3001
WORKER_HOST_PORT=3001
MOCK_PSP_PORT=4001
FRONTEND_PORT=8080

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=payops
DB_USER=payops_admin
DB_PASSWORD=change_me_in_secrets_manager
DB_SSL=false
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000

# Redis Configuration (Cache, Distributed Locks, Streams, Sliding Windows)
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Background Job Queue (BullMQ / Redis RPUSH-BLPOP)
# Supported options: 'redis', 'memory', 'sqs'
QUEUE_DRIVER=redis
SQS_QUEUE_URL=

# Security & Encryption Secrets
# VAULT_ENCRYPTION_KEY: 32-byte (64 hex characters) AES-256-GCM master key for PAN/card encryption
VAULT_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
# WEBHOOK_SIGNING_SECRET: HMAC-SHA256 signing secret for outbound merchant webhooks
WEBHOOK_SIGNING_SECRET=whsec_payops_test_master_secret_key_32bytes!

# Storage Configuration (PDF Invoices)
# If S3_BUCKET_NAME is unset, falls back to local disk storage (/storage/invoices)
S3_BUCKET_NAME=
S3_REGION=eu-north-1
S3_PRESIGNED_TTL_SECONDS=900
LOCAL_STORAGE_PATH=./storage/invoices

# Environment & Observability
APP_DEFAULT_MODE=test
NODE_ENV=development
LOG_LEVEL=info
GIT_COMMIT_SHA=local-dev
JENKINS_BUILD_NUMBER=0
AWS_REGION=eu-north-1
AWS_AVAILABILITY_ZONE=local-dev-az

# Automatic Migration on Startup
AUTO_MIGRATE=true

# Mock PSP Connectors (Integration Testing)
MOCK_STRIPE_URL=http://localhost:4001
MOCK_PAYMO_URL=http://localhost:4002

# Control Center Frontend
VITE_API_URL=http://localhost:3000
SERVE_STATIC_FRONTEND=false
